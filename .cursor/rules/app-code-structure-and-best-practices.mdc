### Zustand Store

```ts
import { create } from "zustand";
import { devtools, persist } from "zustand/middleware";

const STORE_KEY = "domain-name";

export const useDomainStore = create<DomainStore>()(devtools(persist((set) => ({ ...initialValues, setData: (data) => set((state) => ({ ...state, ...data })) }), { name: STORE_KEY })));

export const getDomainStoreState = () => useDomainStore.getState();
```

